"""
Week 4, Day 1 — SciPy: Numerical Integration with scipy.integrate.quad

quad() computes the definite integral of a function using adaptive
quadrature. It returns (result, estimated_absolute_error).

Topics covered:
  1. Basic definite integrals
  2. Integrals with infinite limits
  3. Integrals with extra function parameters (args)
  4. Improper integrals with singularities
  5. Comparing quad's result against the analytical solution
"""

import numpy as np
from scipy import integrate


def basic_integral():
    """Integrate f(x) = x^2 from 0 to 1. Analytical answer = 1/3."""
    f = lambda x: x ** 2
    result, error = integrate.quad(f, 0, 1)
    print(f"1) ∫ x^2 dx from 0 to 1 = {result:.6f} (error ~ {error:.2e})")
    print(f"   Analytical: 1/3 = {1/3:.6f}")
    return result


def trig_integral():
    """Integrate f(x) = sin(x) from 0 to pi. Analytical answer = 2."""
    f = lambda x: np.sin(x)
    result, error = integrate.quad(f, 0, np.pi)
    print(f"2) ∫ sin(x) dx from 0 to π = {result:.6f} (error ~ {error:.2e})")
    print(f"   Analytical: 2.0")
    return result


def infinite_limit_integral():
    """Integrate f(x) = e^(-x^2) from -inf to inf. Analytical answer = sqrt(pi)."""
    f = lambda x: np.exp(-x ** 2)
    result, error = integrate.quad(f, -np.inf, np.inf)
    print(f"3) ∫ e^(-x^2) dx from -∞ to ∞ = {result:.6f} (error ~ {error:.2e})")
    print(f"   Analytical: sqrt(pi) = {np.sqrt(np.pi):.6f}")
    return result


def integral_with_params():
    """Integrate f(x, a, b) = a*x + b using extra args, from 0 to 2."""
    f = lambda x, a, b: a * x + b
    a, b = 2, 3
    result, error = integrate.quad(f, 0, 2, args=(a, b))
    # Analytical: a*x^2/2 + b*x evaluated from 0 to 2 = a*2 + b*2
    analytical = a * (2 ** 2) / 2 + b * 2
    print(f"4) ∫ (2x + 3) dx from 0 to 2 = {result:.6f} (error ~ {error:.2e})")
    print(f"   Analytical: {analytical:.6f}")
    return result


def improper_integral_singularity():
    """Integrate f(x) = 1/sqrt(x) from 0 to 1 (singularity at x=0). Answer = 2."""
    f = lambda x: 1 / np.sqrt(x)
    result, error = integrate.quad(f, 0, 1)
    print(f"5) ∫ 1/sqrt(x) dx from 0 to 1 = {result:.6f} (error ~ {error:.2e})")
    print(f"   Analytical: 2.0")
    return result


if __name__ == "__main__":
    print("SciPy quad() — Numerical Integration Examples\n")
    basic_integral()
    trig_integral()
    infinite_limit_integral()
    integral_with_params()
    improper_integral_singularity()