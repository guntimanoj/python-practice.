"""
Week 4 - Day 2: SciPy - Solving ODEs with solve_ivp
-----------------------------------------------------
Topics covered:
1. Basic first-order ODE (exponential decay)
2. Second-order ODE reduced to a system (simple harmonic oscillator)
3. Comparing solve_ivp methods (RK45 vs Radau)
4. Passing extra parameters to the ODE function
5. Plotting results
"""

import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt


# ---------------------------------------------------------
# 1. First-order ODE: dy/dt = -k*y  (exponential decay)
# ---------------------------------------------------------
def decay(t, y, k=0.5):
    return -k * y

sol1 = solve_ivp(
    decay,
    t_span=(0, 10),          # time interval
    y0=[10],                 # initial condition y(0) = 10
    args=(0.5,),             # extra parameter k
    dense_output=True,       # allows smooth evaluation via sol1.sol(t)
    t_eval=np.linspace(0, 10, 100)
)

print("First-order ODE (decay) solved:", sol1.success)
print("Final value y(10) =", sol1.y[0, -1])


# ---------------------------------------------------------
# 2. Second-order ODE: simple harmonic oscillator
#    y'' + w^2 * y = 0
#    Reduce to system:
#    y1' = y2
#    y2' = -w^2 * y1
# ---------------------------------------------------------
def shm(t, state, w=2.0):
    y1, y2 = state
    dy1dt = y2
    dy2dt = -w**2 * y1
    return [dy1dt, dy2dt]

sol2 = solve_ivp(
    shm,
    t_span=(0, 10),
    y0=[1, 0],                # y(0) = 1, y'(0) = 0
    args=(2.0,),
    t_eval=np.linspace(0, 10, 300)
)

print("\nSecond-order ODE (SHM) solved:", sol2.success)


# ---------------------------------------------------------
# 3. Comparing integration methods: RK45 vs Radau
#    Radau is better for stiff equations
# ---------------------------------------------------------
def stiff_eq(t, y):
    return -50 * y   # stiff decay

sol_rk45 = solve_ivp(stiff_eq, (0, 2), [1], method='RK45', t_eval=np.linspace(0, 2, 50))
sol_radau = solve_ivp(stiff_eq, (0, 2), [1], method='Radau', t_eval=np.linspace(0, 2, 50))

print("\nStiff equation:")
print("RK45 steps taken :", len(sol_rk45.t))
print("Radau steps taken:", len(sol_radau.t))


# ---------------------------------------------------------
# 4. Plotting all results
# ---------------------------------------------------------
fig, axs = plt.subplots(1, 3, figsize=(15, 4))

axs[0].plot(sol1.t, sol1.y[0], label='y(t)')
axs[0].set_title('Exponential Decay')
axs[0].set_xlabel('t')
axs[0].set_ylabel('y')
axs[0].legend()

axs[1].plot(sol2.t, sol2.y[0], label='position y1')
axs[1].plot(sol2.t, sol2.y[1], label='velocity y2')
axs[1].set_title('Simple Harmonic Oscillator')
axs[1].set_xlabel('t')
axs[1].legend()

axs[2].plot(sol_rk45.t, sol_rk45.y[0], 'o-', label='RK45', markersize=3)
axs[2].plot(sol_radau.t, sol_radau.y[0], 's-', label='Radau', markersize=3)
axs[2].set_title('Stiff Equation: RK45 vs Radau')
axs[2].set_xlabel('t')
axs[2].legend()

plt.tight_layout()
plt.savefig('solve_ivp_results.png', dpi=150)
plt.show()

print("\nPlot saved as solve_ivp_results.png")