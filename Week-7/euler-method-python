import numpy as np

def euler_method(f, y0, t0, t_end, h):
    """
    Solve dy/dt = f(t, y) using the forward Euler method.
    """
    n_steps = int(round((t_end - t0) / h))
    t_values = np.zeros(n_steps + 1)
    y_values = np.zeros(n_steps + 1)

    t_values[0] = t0
    y_values[0] = y0

    for i in range(n_steps):
        t = t_values[i]
        y = y_values[i]
        y_values[i + 1] = y + h * f(t, y)   # the core Euler update
        t_values[i + 1] = t + h

    return t_values, y_values