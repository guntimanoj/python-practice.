import numpy as np
import matplotlib.pyplot as plt

from euler import euler_method
from heun_method import heun_method
from rk4 import rk4_method

# Same problem as the user's script: dy/dt = t + y, y(0) = 1
def f(t, y):
    return t + y

def analytical(t):
    return 2 * np.exp(t) - t - 1

t0, y0 = 0, 1
t_end = 1
h = 0.1

t_euler, y_euler = euler_method(f, y0, t0, t_end, h)
t_heun, y_heun = heun_method(f, y0, t0, t_end, h)
t_rk4, y_rk4 = rk4_method(f, y0, t0, t_end, h)
t_fine = np.linspace(t0, t_end, 300)
y_exact = analytical(t_fine)

# --- Plot 1: all four solution curves together ---
fig, ax = plt.subplots(figsize=(8, 5))
ax.plot(t_fine, y_exact, "k--", label="Analytical", linewidth=2)
ax.plot(t_euler, y_euler, "o-", label="Euler", alpha=0.8)
ax.plot(t_heun, y_heun, "^-", label="Heun", alpha=0.8)
ax.plot(t_rk4, y_rk4, "s-", label="RK4", alpha=0.8)
ax.set_xlabel("t")
ax.set_ylabel("y")
ax.set_title(f"dy/dt = t + y, y(0)=1  (h={h})")
ax.legend()
ax.grid(alpha=0.3)
fig.tight_layout()
fig.savefig("/home/claude/ode_practice/compare_solutions.png", dpi=140)

# --- Plot 2: error vs t for each method ---
y_exact_euler = analytical(t_euler)
y_exact_heun = analytical(t_heun)
y_exact_rk4 = analytical(t_rk4)

fig2, ax2 = plt.subplots(figsize=(8, 5))
ax2.plot(t_euler, np.abs(y_euler - y_exact_euler), "o-", label="Euler error")
ax2.plot(t_heun, np.abs(y_heun - y_exact_heun), "^-", label="Heun error")
ax2.plot(t_rk4, np.abs(y_rk4 - y_exact_rk4), "s-", label="RK4 error")
ax2.set_xlabel("t")
ax2.set_ylabel("|numerical - analytical|")
ax2.set_title(f"Error vs. time for each method (h={h})")
ax2.legend()
ax2.set_yscale("log")
ax2.grid(alpha=0.3, which="both")
fig2.tight_layout()
fig2.savefig("/home/claude/ode_practice/compare_errors.png", dpi=140)

print(f"Final values at t={t_end}:")
print(f"  Analytical: {y_exact[-1]:.6f}")
print(f"  Euler:      {y_euler[-1]:.6f}  (error {abs(y_euler[-1]-y_exact[-1]):.6f})")
print(f"  Heun:       {y_heun[-1]:.6f}  (error {abs(y_heun[-1]-y_exact[-1]):.6f})")
print(f"  RK4:        {y_rk4[-1]:.6f}  (error {abs(y_rk4[-1]-y_exact[-1]):.6f})")